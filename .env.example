# Copy this file to backend/.env and fill in your actual secret values.
# Keep actual secrets strictly in backend/.env (never commit .env to version control).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_TIMEOUT_SECONDS="9.0"
GEMINI_MAX_RETRIES="2"
GEMINI_DAILY_QUOTA_LIMIT="1000"
GEMINI_MINUTE_QUOTA_LIMIT="60"
QUOTA_HIGH_WATER_RATIO="0.85"
USER_DAILY_SCAN_LIMIT="20"
MAX_CONCURRENT_HEAVY_REQUESTS="3"
CIRCUIT_BREAKER_FAILURE_THRESHOLD="3"
CIRCUIT_BREAKER_COOLDOWN_SECONDS="60.0"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:1.5b"
OLLAMA_NUM_CTX="2048"
OLLAMA_TIMEOUT_SECONDS="5.0"
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_HERE"
DATABASE_URL="sqlite:///./agrosphere.db"


